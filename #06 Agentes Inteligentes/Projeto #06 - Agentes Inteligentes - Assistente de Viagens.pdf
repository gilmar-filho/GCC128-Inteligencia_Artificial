/Title (@tool def cotacao_moeda\(par: str\) -> str:     """Retorna a cotacao atual de um par de moedas.     Parametro: par no formato 'USD-BRL', 'EUR-BRL' etc."""     dados = requests.get\(         f"https://economia.awesomeapi.com.br/last/{par}"     \).json\(\)     c = dados[par.replace\("-", ""\)]     return f"1 {c['code']} = {float\(c['bid']\):.2f} {c['codein']}")
